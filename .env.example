# 本地开发：调试模式，允许所有来源
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 生产环境（docker compose 会读取这些值）
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<至少 50 位随机字符串>
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DB_PATH=/app/db/db.sqlite3
# DJANGO_AUDIO_DIR=/var/lib/english-vocabulary/audio
# DJANGO_SECURE_COOKIES=1
# DJANGO_USE_X_FORWARDED_PROTO=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.example
# DJANGO_AUTH_THROTTLE_RATE=10/min

# 邮箱验证码 / 找回密码。开发环境默认把邮件打到控制台（不用配 SMTP）；
# 生产必须配 SMTP，否则发码接口会返回 502。
# 国内云服务器 25 端口基本被封，用 465(SSL) 或 587(TLS)。
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=465
# DJANGO_EMAIL_USER=no-reply@example.com
# DJANGO_EMAIL_PASSWORD=<邮箱密码或授权码>
# DJANGO_EMAIL_USE_SSL=1
# DJANGO_EMAIL_USE_TLS=0
# DJANGO_DEFAULT_FROM_EMAIL=英语单词记忆 <no-reply@example.com>
# DJANGO_EMAIL_CODE_TTL=10
# DJANGO_EMAIL_CODE_COOLDOWN=60
# DJANGO_EMAIL_CODE_MAX_ATTEMPTS=5
# DJANGO_EMAIL_CODE_EMAIL_HOURLY_LIMIT=5
# DJANGO_EMAIL_CODE_IP_HOURLY_LIMIT=20
