# 本地开发：调试模式，允许所有来源
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 生产环境（docker compose 会读取这些值）
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<至少 50 位随机字符串>
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DB_PATH=/app/db/db.sqlite3
# DJANGO_AUDIO_DIR=/var/lib/english-vocabulary/audio
# DJANGO_SECURE_COOKIES=1
# DJANGO_USE_X_FORWARDED_PROTO=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.example
# DJANGO_AUTH_THROTTLE_RATE=10/min
