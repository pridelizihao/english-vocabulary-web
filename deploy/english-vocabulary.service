[Unit]
Description=English Vocabulary backend (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/english-vocabulary/backend
EnvironmentFile=/opt/english-vocabulary/.env
ExecStart=/opt/english-vocabulary/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
